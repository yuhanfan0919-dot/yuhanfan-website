---
import Layout from '../../../layouts/Layout.astro';

const highlights = [
  { label: 'Timeline', value: '5 Weeks', detail: 'From zero to a production-grade e-commerce system.' },
  { label: 'Scope', value: 'External + Internal', detail: 'Customer ordering and store operations designed in tandem.' },
  { label: 'Status', value: 'Live', detail: 'End-to-end payment pipeline verified · Processing real-world paid orders.' },
  { label: 'Pre-launch Risk Audit', value: '1 Week', detail: 'Rigorous audit of payments, webhook callbacks, and rate limiting prior to launch.' },
];

const securityItems = [
  ['Duplicate payment callbacks', 'A successful callback can be retried by the gateway due to network issues.', 'Gate state transitions on current order status — duplicates return 200 but trigger no side effects.'],
  ['Amount tampering', 'The client-submitted total can be changed by a user in the request.', 'Always recompute the final total server-side from item IDs before payment — the frontend price is display-only.'],
  ['Webhook forgery', 'A public webhook URL can be spoofed, impersonating Telegram.', 'Validate the secret_token in the webhook header; reject mismatches with 401.'],
  ['OTP abuse', 'SMS codes cost real money; an unprotected endpoint gets drained.', 'Upstash Redis rate limiting by IP + phone number, two dimensions.'],
];
---

<Layout
  title="oppachikin project retrospective: from 0 to a production operations system | Rain Fan"
  description="A production-grade e-commerce and internal operations system delivered 0→1 in 5 weeks for a real paying client, built with AI agent collaboration."
  lang="en"
>
  <article class="case-study">
    <header class="case-hero">
      <div class="container-page case-hero-grid">
        <div>
          <a href="/en/" class="case-back" aria-label="Back to home">
            <span aria-hidden="true">←</span>
            <span>Back to home</span>
          </a>

          <p class="eyebrow mb-5" style="color: var(--color-muted);">Project retrospective / 2026.03 – Present</p>
          <h1 class="display case-title">
            <a
              href="https://oppachikin.by"
              target="_blank"
              rel="noopener noreferrer"
              class="case-title-link"
              title="Visit the live oppachikin site"
            >oppachikin<span class="case-title-go" aria-hidden="true">↗</span></a>
          </h1>
          <p class="case-lead">
            More than just a website for a fried chicken shop —<br />
            an end-to-end operations system spanning customer ordering, payment, and delivery,<br />
            through to internal scheduling and payroll.
          </p>
        </div>

        <figure class="case-visual" aria-label="oppachikin online ordering page">
          <a
            href="https://oppachikin.by"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit the live oppachikin site"
          >
            <img src="/experience/menu02.jpg" alt="oppachikin online ordering menu screenshot" />
          </a>
        </figure>
      </div>
    </header>

    <main class="container-page case-main">
      <section class="metric-grid" aria-label="Project highlights">
        {highlights.map((item) => (
          <div class="metric-tile">
            <p>{item.label}</p>
            <strong>{item.value}</strong>
            <span>{item.detail}</span>
          </div>
        ))}
      </section>

      <section class="case-section">
        <div class="section-kicker">01 / External: Customer Experience</div>
        <div class="section-heading">
          <h2>From "Phone-Only" to "Self-Service E-commerce"</h2>
          <p>
            In Minsk, most restaurant orders still rely on walk-ins and phone calls. Even high Instagram traffic failed to convert because there was no landing page. Here, a website isn't just a bonus channel — it's the primary driver for customer acquisition.
          </p>
        </div>

        <div class="flow-diff">
          <div class="flow-diff-head">
            <span class="flow-label"></span>
            <span></span>
            <span></span>
          </div>
          <ol>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Order Channel</strong> Phone or walk-in only (zero direct conversion from Instagram).</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Seamless Instagram-to-website conversion for 24/7 self-service ordering.</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Delivery Transparency</strong> Opaque delivery availability and pricing until you called.</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Transparent, automated delivery fee calculation at checkout.</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Payment Method</strong> Cash-only, in-person transactions.</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Integrated Alfa Bank digital payments for a 100% cashless flow.</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Order Tracking</strong> Blind waiting post-purchase with no status updates.</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">End-to-end real-time tracking for both order prep and delivery.</span>
            </li>
          </ol>
        </div>
      </section>

      <section class="case-section">
        <div class="section-kicker">02 / Internal: Store Operations</div>
        <div class="section-heading">
          <h2>From "Manual & Reactive" to "Automated Workflows"</h2>
          <p>Customers never see this backend—but it's where we free the owner and staff from repetitive monitoring, manual calculations, and complex payroll settlements.</p>
        </div>

        <div class="flow-diff">
          <div class="flow-diff-head">
            <span class="flow-label"></span>
            <span></span>
            <span></span>
          </div>
          <ol>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Order Fulfillment</strong> Staff could only take manual orders and cook on the spot.</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Orders auto-route to a Telegram staff channel. One click marks an order "done," instantly syncing the status to the customer.</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Delivery Dispatch</strong> Manually hailing a courier for every single delivery.</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Automated courier dispatch via the Yandex B2B API the moment preparation is complete.</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Shift Scheduling</strong> Chaotic group chats prone to human error and missed shifts.</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">One-click, self-service weekly shift selection via a custom Telegram bot.</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Time-Tracking & Payroll</strong> Manual hour tallying and payroll calculations at month-end.</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Automated time-tracking and instant payroll calculation via the bot.</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">Customer Retention</strong> Repeat business relied purely on the owner's memory.</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Automated membership and loyalty point system. <em>(Built with an append-only transaction ledger—because anything involving financial value requires a strict audit trail.)</em></span>
            </li>
          </ol>
        </div>
      </section>

      <section class="case-section pricing-section">
        <div class="section-kicker">03 / Delivery automation</div>
        <div class="section-heading">
          <h2>Pricing delivery with data, not gut feel</h2>
          <p>Delivery is the easiest place to lose money. Instead of guessing, we sampled real Yandex courier fares across distances and time bands to build a defensible pricing table. After cooking, the system auto-dispatches; edge cases route to a human.</p>
        </div>

        <div class="pricing-layout">
          <div class="pricing-panel">
            <p class="panel-label">How we price</p>
            <h3>Distance × time-of-day banding from real samples</h3>
            <div class="sample-equation" aria-label="Sampling scale">
              <span>8 fixed routes (0.9–12 km)</span>
              <strong>×</strong>
              <span>~5 days continuous sampling</span>
              <strong>=</strong>
              <span>2,592 samples</span>
            </div>
            <p>
              A Vercel Cron job samples Yandex real-time fares every 10 minutes into Supabase, then bands them by distance × time-of-day (off-peak / light peak / strong peak) to generate the customer-facing price table.
            </p>
          </div>

          <div class="pricing-panel">
            <p class="panel-label">How we dispatch</p>
            <h3>Auto by default, human fallback for edge cases</h3>
            <p>
              After cooking, the system re-quotes at dispatch time and uses the free <code>claims/create</code> as a true-price probe (only <code>accept</code> is charged). Normal orders auto-dispatch; 12 km+, anomalies, and failures route to a human.
            </p>
          </div>
        </div>

        <div class="insight-strip">
          <div>
            <p>Sampling</p>
            <strong>2,592 real samples</strong>
            <span>Cron every 10 min across 8 fixed routes.</span>
          </div>
          <div>
            <p>Pricing</p>
            <strong>Distance × time-of-day banded</strong>
            <span>Reproducible, not gut-based.</span>
          </div>
          <div>
            <p>Fallback</p>
            <strong>Anomalies always go to a human</strong>
            <span>No hard-forcing edge cases.</span>
          </div>
        </div>
      </section>

      <section class="case-section">
        <div class="section-kicker">04 / Security audit</div>
        <div class="section-heading">
          <h2>The most important step before launch: security audit</h2>
          <p>
            Getting features to work is just step one. Before going live, every loophole that could cause real financial damage needs to be closed — this system had to hold up to real money and real traffic. None of this was built up front — I dedicated a full week near launch to a security audit and patched these one by one.
          </p>
        </div>

        <div class="security-grid">
          {securityItems.map(([risk, problem, fix]) => (
            <article class="risk-card">
              <p class="risk-label">{risk}</p>
              <h3>{problem}</h3>
              <p>{fix}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="case-section agent-section">
        <div class="section-kicker">05 / Agent collaboration</div>
        <div class="section-heading">
          <h2>AI didn't think for me — it amplified my judgment</h2>
          <p>AI doesn't make product decisions for me. It makes the gap between "an idea I can articulate" and "a working implementation" 10x narrower. The bottleneck becomes how clearly I can think. This project is exactly what my resume says: hand the workflow to an agent — after I first figure out the business rules, risk boundaries, and trade-offs.</p>
        </div>

        <div class="agent-split">
          <div>
            <p class="panel-label">What I own</p>
            <ul>
              <li>Understanding how a real store actually operates</li>
              <li>Deciding which risks must be closed before launch</li>
              <li>Turning "experience" into testable hypotheses</li>
              <li>Choosing where to automate vs. keep a human in the loop</li>
              <li>Managing non-code blockers (compliance, external approvals) in the launch plan — e.g., the 5-day wait for SMS alphaname approval</li>
            </ul>
          </div>
          <div>
            <p class="panel-label">What the agent does</p>
            <ul>
              <li>Mapping out API integration paths</li>
              <li>Generating and refactoring TypeScript code</li>
              <li>Debugging payment, webhook, and cron issues</li>
              <li>Translating the security checklist into concrete implementations</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="case-close">
        <p class="eyebrow mb-4">Reflection</p>
        <h2>This isn't proof that I can "build a website."</h2>
        <p>
          It's proof that I can sit with a real client, untangle a messy, exception-filled business process, and turn it into a system that runs, can be audited, and can keep iterating.
        </p>
        <a href="/en/#contact" class="btn-primary">Let's talk workflow automation</a>
      </section>
    </main>
  </article>

</Layout>

<style>
  .case-study {
    background: var(--color-bg-light);
  }

  .case-hero {
    padding: 6.5rem 0 4.5rem;
    background: var(--color-bg-light);
    border-bottom: 1px dashed var(--color-border);
  }

  .case-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.75fr);
    gap: 3rem;
    align-items: center;
  }

  .case-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .case-back:hover {
    color: var(--color-accent);
  }

  .case-title {
    margin-bottom: 1.5rem;
    font-size: clamp(3.25rem, 8vw, 7rem);
  }

  .case-title-link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .case-title-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.08em;
    text-decoration-thickness: 0.06em;
  }

  .case-title-go {
    display: inline-block;
    font-size: 0.36em;
    vertical-align: super;
    margin-left: 0.06em;
    transition: transform 0.2s ease;
  }

  .case-title-link:hover .case-title-go {
    transform: translate(0.12em, -0.12em);
  }

  .case-lead {
    max-width: 760px;
    color: var(--color-ink-2);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.5vw, 2.1rem);
    line-height: 1.35;
  }

  .panel-label,
  .section-kicker,
  .flow-label,
  .risk-label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-kicker {
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }

  .case-visual {
    overflow: hidden;
    margin: 0;
    border: 1px dashed var(--color-border);
    border-radius: 1rem;
    background: var(--color-canvas-tint);
    box-shadow: 0 18px 48px -34px rgba(46, 51, 64, 0.34);
  }

  .case-visual a {
    display: block;
  }

  .case-visual img {
    display: block;
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
    object-position: top;
  }

  .case-main {
    padding-bottom: 6rem;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 5rem;
  }

  .metric-tile,
  .flow-column,
  .risk-card,
  .pricing-panel,
  .system-detail,
  .agent-split > div,
  .case-close {
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-canvas);
    box-shadow: 0 16px 42px -38px rgba(46, 51, 64, 0.28);
  }

  .metric-tile {
    padding: 1.1rem;
  }

  .metric-tile p,
  .metric-tile span {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .metric-tile strong {
    display: block;
    margin: 0.35rem 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
  }

  .case-section {
    padding: 5rem 0;
    border-top: 1px dashed var(--color-border);
  }

  .section-heading {
    margin-top: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .section-heading:has(p) {
    margin-bottom: 1.75rem;
  }

  .section-heading p {
    margin-top: 1.1rem;
    max-width: 52rem;
  }

  .section-heading h2,
  .case-close h2 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .section-heading p,
  .case-close p {
    color: var(--color-ink-2);
    font-size: 1.04rem;
    line-height: 1.75;
  }

  .flow-diff-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.25rem;
    align-items: center;
    padding-bottom: 0.6rem;
  }

  .flow-diff-head span:last-child {
    padding-left: 0.9rem;
  }

  .flow-diff ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px dashed var(--color-border);
  }

  .flow-old {
    color: var(--color-ink);
  }

  .flow-row-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.35rem;
  }

  .flow-arrow {
    color: var(--color-accent);
    font-size: 1.1rem;
  }

  .flow-new {
    padding: 0.55rem 0.9rem;
    border-radius: 0.65rem;
    background: var(--color-highlight);
    color: var(--color-ink);
    font-weight: 500;
  }

  /* 配对行错峰浮现(复用全局 .reveal/.visible + IntersectionObserver) */
  .flow-row.reveal:nth-child(2) { transition-delay: 0.08s; }
  .flow-row.reveal:nth-child(3) { transition-delay: 0.16s; }
  .flow-row.reveal:nth-child(4) { transition-delay: 0.24s; }

  @media (max-width: 640px) {
    .flow-diff-head { display: none; }
    .flow-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .flow-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }

  .timeline {
    display: grid;
    gap: 0.8rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .timeline-item span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .timeline-item h3 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
  }

  .timeline-item p,
  .risk-card p,
  .pricing-panel p,
  .system-detail-body,
  .agent-split li,
  .insight-strip span,
  .compliance-row span {
    color: var(--color-ink-2);
    line-height: 1.65;
  }

  .system-map {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .system-node-list {
    display: grid;
    gap: 0.65rem;
  }

  .system-node {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-canvas);
    color: var(--color-ink-2);
    font-weight: 600;
    text-align: left;
    transition: all 0.2s ease;
  }

  .system-node:hover,
  .system-node.active {
    border-color: var(--color-accent);
    background: var(--color-highlight);
    color: var(--color-ink);
  }

  .system-detail {
    min-height: 14rem;
    padding: 1.5rem;
  }

  .system-detail-title {
    margin-bottom: 0.75rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
  }

  .security-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .risk-card {
    padding: 1.25rem;
  }

  .risk-card h3 {
    min-height: 2.6rem;
    margin: 0.65rem 0 0.85rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .pricing-section {
    margin-inline: -1.5rem;
    padding-inline: 1.5rem;
    background: var(--color-bg-mid);
    border: 1px dashed var(--color-border);
    border-radius: 1rem;
  }

  .pricing-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1rem;
  }

  .pricing-panel {
    padding: 1.5rem;
  }

  .pricing-panel h3 {
    margin: 0.8rem 0 1rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .sample-equation {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .sample-equation span,
  .sample-equation strong {
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-canvas);
    color: var(--color-ink);
    font-size: 0.86rem;
  }

  .pricing-panel code {
    color: var(--color-accent-deep);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .insight-strip,
  .compliance-row,
  .agent-split {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .insight-strip > div,
  .compliance-row > div {
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-canvas);
    box-shadow: 0 16px 42px -38px rgba(46, 51, 64, 0.28);
  }

  .insight-strip p,
  .compliance-row span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .insight-strip strong,
  .compliance-row strong {
    display: block;
    margin: 0.55rem 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .agent-split {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .agent-split > div {
    padding: 1.5rem;
  }

  .agent-split ul {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
    padding-left: 1rem;
  }

  .case-close {
    margin-top: 5rem;
    padding: 2rem;
  }

  .case-close p {
    max-width: 760px;
    margin: 1rem 0 1.5rem;
  }

  @media (max-width: 960px) {
    .case-hero-grid,
    .section-heading,
    .system-map,
    .pricing-layout,
    .agent-split {
      grid-template-columns: 1fr;
    }

    .metric-grid,
    .security-grid,
    .insight-strip,
    .compliance-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

