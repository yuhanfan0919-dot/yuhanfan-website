---
import Layout from '../../layouts/Layout.astro';

const highlights = [
  { label: '交付周期', value: '5 周', detail: '从 0 到生产级电商系统' },
  { label: '系统范围', value: '对外 + 对内', detail: '顾客下单与门店运营一起设计' },
  { label: '上线状态', value: '已上线', detail: '跑通支付 · 收到真实付款订单' },
  { label: '上线风控', value: '1 周', detail: '集中复核支付、回调与限流' },
];

const securityItems = [
  ['支付回调重复', '同一笔成功回调可能被银行重试多次。', '用订单状态做幂等判断，重复回调返回成功但不再触发副作用。'],
  ['金额篡改', '前端传来的价格能被用户篡改。', '付款前在服务端根据商品 ID 重新计算总价，前端价格只用于展示。'],
  ['Webhook 伪造', '公开 URL 可能被伪造、冒充 Telegram。', '校验 secret token，密钥不匹配的请求直接拒绝。'],
  ['验证码刷量', '短信验证码是真成本，接口不设限会被刷量烧钱。', '用 Upstash Redis 按 IP + 手机号双维度限流。'],
];
---

<Layout
  title="oppachikin 项目复盘：把炸鸡店流程交给 AI agents | Rain Fan"
  description="一个由非科班开发者借助 AI 协作，从外部点餐系统延伸到内部运营流程的真实项目复盘。"
  lang="zh"
>
  <article class="case-study">
    <header class="case-hero">
      <div class="container-page case-hero-grid">
        <div>
          <a href="/" class="case-back" aria-label="返回主页">
            <span aria-hidden="true">←</span>
            <span>返回主页</span>
          </a>

          <p class="eyebrow mb-5" style="color: var(--color-muted);">Project retrospective / 2026.03 - Present</p>
          <h1 class="display case-title">
            <a
              href="https://oppachikin.by"
              target="_blank"
              rel="noopener noreferrer"
              class="case-title-link"
              title="点击访问 oppachikin 线上站点"
            >oppachikin<span class="case-title-go" aria-hidden="true">↗</span></a>
          </h1>
          <p class="case-lead">
            不只是给一家炸鸡店做官网——<br />
            而是交付一套从顾客下单、支付、配送到<br />
            内部排班、薪资结算的运营系统。
          </p>
        </div>

        <figure class="case-visual" aria-label="oppachikin 线上点餐页">
          <a
            href="https://oppachikin.by"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="访问 oppachikin 线上站点"
          >
            <img src="/experience/menu02.jpg" alt="oppachikin 线上点餐菜单页截图" />
          </a>
        </figure>
      </div>
    </header>

    <main class="container-page case-main">
      <section class="metric-grid" aria-label="项目关键数据">
        {highlights.map((item) => (
          <div class="metric-tile">
            <p>{item.label}</p>
            <strong>{item.value}</strong>
            <span>{item.detail}</span>
          </div>
        ))}
      </section>

      <section class="case-section">
        <div class="section-kicker">01 / 对外 · 顾客的体验</div>
        <div class="section-heading">
          <h2>从「只能打电话」到「官网自助下单」</h2>
        </div>

        <div class="flow-diff">
          <div class="flow-diff-head">
            <span class="flow-label">before</span>
            <span></span>
            <span class="flow-label">after</span>
          </div>
          <ol>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">下单渠道</strong>只能打电话、或到店点单（在 Instagram 看到也只能打电话）</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Instagram 链接一点直达官网，随时自助下单</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">配送透明度</strong>下单前根本不知道能不能送、运费多少</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">官网下外卖单，支付时即可显示配送费</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">支付方式</strong>付款只能到店、只能用现金</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">Alfa Bank 电子支付，全程电子化</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">订单追踪</strong>下单后只能干等，不知道做没做、送到哪</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">全程实时查看订单与配送状态</span>
            </li>
          </ol>
        </div>
      </section>

      <section class="case-section">
        <div class="section-kicker">02 / 对内 · 门店的运营</div>
        <div class="section-heading">
          <h2>从「靠人盯、手动办」到「自动流转、一键搞定」</h2>
          <p>这部分顾客看不到，却是把老板和员工从重复的盯人、统计、结算里解放出来的地方。</p>
        </div>

        <div class="flow-diff">
          <div class="flow-diff-head">
            <span class="flow-label">before</span>
            <span></span>
            <span class="flow-label">after</span>
          </div>
          <ol>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">接单出餐</strong>店员只能在店里接单、现场制作</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">网站下单自动推送 Telegram 员工群，一键接单；<br />点「制作完成」顾客同步看到状态</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">配送调度</strong>送外卖全靠员工手动叫车</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">对接 Yandex B2B API，制作完成自动叫车</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">员工排班</strong>员工排班靠群里接龙，乱、还容易漏</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">每周用 Telegram bot 一键自助选班</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">工时薪资</strong>老板每到月底手动统计工时、算工资</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">bot 自动累计工时、直接算好工资</span>
            </li>
            <li class="flow-row reveal">
              <span class="flow-old"><strong class="flow-row-title">会员留存</strong>回头客全靠老板记、留不住</span>
              <span class="flow-arrow" aria-hidden="true">⟶</span>
              <span class="flow-new">会员积分自动沉淀回头客</span>
            </li>
          </ol>
        </div>
      </section>

      <section class="case-section pricing-section">
        <div class="section-kicker">03 / Delivery automation</div>
        <div class="section-heading">
          <h2>配送定价：用数据敲运费，不靠拍脑袋</h2>
          <p>配送是最容易亏钱的环节。运费不靠感觉——按距离 × 时段，用真实采样数据敲出一张价格表；出餐后自动发车，超距等异常再转人工兜底。</p>
        </div>

        <div class="pricing-layout">
          <div class="pricing-panel">
            <p class="panel-label">怎么定价</p>
            <h3>用真实采样数据按「距离 × 时段」定档</h3>
            <div class="sample-equation" aria-label="采样规模">
              <span>8 个固定点位（0.9–12km）</span>
              <strong>×</strong>
              <span>约 5 天连续采样</span>
              <strong>=</strong>
              <span>2,592 条采样</span>
            </div>
            <p>
              Vercel Cron 每 10 分钟采一次 Yandex 实时报价，写入 Supabase；再按距离 × 时段（平峰 / 轻高峰 / 强高峰）定档，生成给顾客的价格表。
            </p>
          </div>

          <div class="pricing-panel">
            <p class="panel-label">怎么发车</p>
            <h3>正常自动，异常永远有人工兜底</h3>
            <p>
              出餐后系统按当前运价自动发车；超 12km、异常订单自动转人工——不让系统在边界情况上硬扛。
            </p>
          </div>
        </div>

        <div class="insight-strip">
          <div>
            <p>采样</p>
            <strong>2,592 条真实样本</strong>
            <span>Cron 每 10 分钟采 8 个固定点位。</span>
          </div>
          <div>
            <p>定价</p>
            <strong>按距离 × 时段定档</strong>
            <span>可复算、不拍脑袋，价格有据可依。</span>
          </div>
          <div>
            <p>兜底</p>
            <strong>异常永远转人工</strong>
            <span>超 12km、失败回退不让系统硬扛。</span>
          </div>
        </div>
      </section>

      <section class="case-section">
        <div class="section-kicker">04 / Security audit</div>
        <div class="section-heading">
          <h2>上线前最重要的一步：安全审计</h2>
          <p>功能能跑只是第一步。上线前，需要把那些能被钻空子、会造成真实损失的地方逐一堵上，让它经得起真实的钱和真实的流量。</p>
        </div>

        <div class="security-grid">
          {securityItems.map(([risk, problem, fix]) => (
            <article class="risk-card">
              <p class="risk-label">{risk}</p>
              <h3>{problem}</h3>
              <p>{fix}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="case-section agent-section">
        <div class="section-kicker">05 / AI agents collaboration</div>
        <div class="section-heading">
          <h2>AI 没有替我思考，但它放大了我的判断</h2>
          <p>这个项目最像我简历里那句话：把流程交给 AI agents。前提是，我先把业务规则、风险边界和取舍想清楚。</p>
        </div>

        <div class="agent-split">
          <div>
            <p class="panel-label">我负责</p>
            <ul>
              <li>理解真实门店的操作习惯</li>
              <li>判断哪些风险上线前必须补</li>
              <li>把“经验”转成可验证的数据假设</li>
              <li>决定哪里自动化，哪里保留人工兜底</li>
            </ul>
          </div>
          <div>
            <p class="panel-label">AI agents 负责</p>
            <ul>
              <li>拆解 API 对接路径</li>
              <li>生成和重构 TypeScript 代码</li>
              <li>辅助定位支付、Webhook、Cron 问题</li>
              <li>把安全 checklist 落到具体实现</li>
            </ul>
          </div>
        </div>
      </section>
    </main>
  </article>

</Layout>

<style>
  .case-study {
    background: var(--color-bg-light);
  }

  .case-hero {
    padding: 6.5rem 0 4.5rem;
    background: var(--color-bg-light);
    border-bottom: 1px dashed var(--color-border);
  }

  .case-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.75fr);
    gap: 3rem;
    align-items: center;
  }

  .case-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .case-back:hover {
    color: var(--color-accent);
  }

  .case-title {
    margin-bottom: 1.5rem;
    font-size: clamp(3.25rem, 8vw, 7rem);
  }

  .case-title-link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .case-title-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.08em;
    text-decoration-thickness: 0.06em;
  }

  .case-title-go {
    display: inline-block;
    font-size: 0.36em;
    vertical-align: super;
    margin-left: 0.06em;
    transition: transform 0.2s ease;
  }

  .case-title-link:hover .case-title-go {
    transform: translate(0.12em, -0.12em);
  }

  .case-lead {
    max-width: 760px;
    color: var(--color-ink-2);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.5vw, 2.1rem);
    line-height: 1.35;
  }

  .panel-label,
  .section-kicker,
  .flow-label,
  .risk-label {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-kicker {
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }

  .case-visual {
    overflow: hidden;
    margin: 0;
    border: 1px dashed var(--color-border);
    border-radius: 1rem;
    background: var(--color-canvas-tint);
    box-shadow: 0 18px 48px -34px rgba(46, 51, 64, 0.34);
  }

  .case-visual a {
    display: block;
  }

  .case-visual img {
    display: block;
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
    object-position: top;
  }

  .case-main {
    padding-bottom: 6rem;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 5rem;
  }

  .metric-tile,
  .flow-column,
  .risk-card,
  .pricing-panel,
  .system-detail,
  .agent-split > div,
  .case-close {
    border: 1px solid var(--color-border);
    border-radius: 0.875rem;
    background: var(--color-canvas);
    box-shadow: 0 16px 42px -38px rgba(46, 51, 64, 0.28);
  }

  .metric-tile {
    padding: 1.1rem;
  }

  .metric-tile p,
  .metric-tile span {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .metric-tile strong {
    display: block;
    margin: 0.35rem 0;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
  }

  .case-section {
    padding: 5rem 0;
    border-top: 1px dashed var(--color-border);
  }

  .section-heading {
    margin-top: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .section-heading:has(p) {
    margin-bottom: 1.75rem;
  }

  .section-heading p {
    margin-top: 1.1rem;
    max-width: 52rem;
  }

  .section-heading h2,
  .case-close h2 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .section-heading p,
  .case-close p {
    color: var(--color-ink-2);
    font-size: 1.04rem;
    line-height: 1.75;
  }

  .flow-diff-head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.25rem;
    align-items: center;
    padding-bottom: 0.6rem;
  }

  .flow-diff-head span:last-child {
    padding-left: 0.9rem;
  }

  .flow-diff ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.25rem;
    align-items: center;
    padding: 0.85rem 0;
    border-top: 1px dashed var(--color-border);
  }

  .flow-old {
    color: var(--color-ink);
  }

  .flow-row-title {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    margin-bottom: 0.28rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .flow-row-title::before {
    content: '';
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 0.18rem color-mix(in srgb, var(--color-accent) 16%, transparent);
    flex: 0 0 auto;
  }

  .flow-arrow {
    color: var(--color-accent);
    font-size: 1.1rem;
  }

  .flow-new {
    padding: 0.55rem 0.9rem;
    border-radius: 0.65rem;
    background: var(--color-highlight);
    color: var(--color-ink);
    font-weight: 500;
  }

  /* 配对行错峰浮现(复用全局 .reveal/.visible + IntersectionObserver) */
  .flow-row.reveal:nth-child(2) { transition-delay: 0.08s; }
  .flow-row.reveal:nth-child(3) { transition-delay: 0.16s; }
  .flow-row.reveal:nth-child(4) { transition-delay: 0.24s; }

  @media (max-width: 640px) {
    .flow-diff-head { display: none; }
    .flow-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .flow-arrow {
      transform: rotate(90deg);
      justify-self: center;
    }
  }

  .timeline {
    display: grid;
    gap: 0.8rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .timeline-item span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .timeline-item h3 {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
  }

  .timeline-item p,
  .risk-card p,
  .pricing-panel p,
  .system-detail-body,
  .agent-split li,
  .insight-strip span,
  .compliance-row span {
    color: var(--color-ink-2);
    line-height: 1.65;
  }

  .system-map {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .system-node-list {
    display: grid;
    gap: 0.65rem;
  }

  .system-node {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-canvas);
    color: var(--color-ink-2);
    font-weight: 600;
    text-align: left;
    transition: all 0.2s ease;
  }

  .system-node:hover,
  .system-node.active {
    border-color: var(--color-accent);
    background: var(--color-highlight);
    color: var(--color-ink);
  }

  .system-detail {
    min-height: 14rem;
    padding: 1.5rem;
  }

  .system-detail-title {
    margin-bottom: 0.75rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
  }

  .security-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .risk-card {
    padding: 1.25rem;
  }

  .risk-card h3 {
    min-height: 2.6rem;
    margin: 0.65rem 0 0.85rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .pricing-section {
    margin-inline: -1.5rem;
    padding-inline: 1.5rem;
    background: var(--color-bg-mid);
    border: 1px dashed var(--color-border);
    border-radius: 1rem;
  }

  .pricing-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1rem;
  }

  .pricing-panel {
    padding: 1.5rem;
  }

  .pricing-panel h3 {
    margin: 0.8rem 0 1rem;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .sample-equation {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .sample-equation span,
  .sample-equation strong {
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-canvas);
    color: var(--color-ink);
    font-size: 0.86rem;
  }

  .pricing-panel code {
    color: var(--color-accent-deep);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .insight-strip,
  .compliance-row,
