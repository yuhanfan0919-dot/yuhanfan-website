---
import type { Content } from '../data/content.ts';

interface Props {
  data: Content['about'];
}
const { data } = Astro.props;
---

<section id="about" class="section">
  <div class="container-page">
    <div class="grid md:grid-cols-12 gap-12 md:gap-16">
      <!-- 左侧：双标语 -->
      <div class="md:col-span-5">
        <p class="eyebrow mb-6 reveal">{data.eyebrow}</p>
        <h2 class="display text-4xl md:text-5xl lg:text-6xl reveal leading-tight">
          {data.titleLines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </h2>
      </div>

      <!-- 右侧：段落 + pullquote -->
      <div class="md:col-span-7">
        <div class="max-w-prose">
          {data.paragraphs.map((p) => (
            <p
              class="text-base md:text-lg leading-relaxed mb-6 reveal"
              style="color: var(--color-ink-2);"
            >
              {p}
            </p>
          ))}

          {data.pullquote && (
            <blockquote class="pullquote mt-10 text-base md:text-lg reveal">
              {data.pullquote}
            </blockquote>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
