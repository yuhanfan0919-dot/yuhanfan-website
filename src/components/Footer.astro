---
const t = {
  tagline: 'AI for repetition. Humans for creation.',
  year: '© 2026 Rain Fan',
};
---

<footer
  class="mt-20 py-12"
  style="border-top: 1px dashed var(--color-border);"
>
  <div class="container-page">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div>
        <p
          class="font-serif text-xl leading-snug max-w-md"
          style="color: var(--color-ink);"
        >
          {t.tagline}
        </p>
      </div>
      <div class="text-xs font-mono" style="color: var(--color-whisper);">
        <p>{t.year}</p>
      </div>
    </div>
  </div>
</footer>
