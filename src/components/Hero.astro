---
import type { Content } from '../data/content.ts';

interface Props {
  data: Content['hero'];
  lang: 'zh' | 'en';
}
const { data, lang } = Astro.props;
const titlePrefixLines = data.titlePrefix.split('\n');
const taglineLines = data.tagline.split('\n');
---

<section class="section pt-32 md:pt-40">
  <div class="container-page">
    <div class="grid md:grid-cols-12 gap-8 md:gap-12 items-center">
      <!-- 左侧：文字内容 -->
      <div class="md:col-span-7 lg:col-span-8">
        <!-- H1: 问候 + 名字（Robin / Zitilei 风格的开场） -->
        <h1 class="display text-5xl md:text-6xl lg:text-7xl mb-5 reveal" set:html={data.greeting.replace('Rain', '<span style="color:var(--color-accent)">Rain</span>')}>
        </h1>

        <!-- H2: 原主标题降级为价值主张副标题（content.ts 置空时不渲染） -->
        {data.titlePrefix.trim() && (
          <h2 class="display text-2xl md:text-3xl lg:text-4xl mb-8 reveal" style="color: var(--color-ink-2); font-weight: 500;">
            {titlePrefixLines.map((line, index) => (
              <span class="block">
                {line}
                {index === titlePrefixLines.length - 1 && (
                  <>
                    <span style="color:var(--color-accent); font-weight: 600;">{data.titleAccent}</span>{data.titleSuffix}
                  </>
                )}
              </span>
            ))}
          </h2>
        )}

        <!-- 三段式 pill chips -->
        <div class="flex flex-wrap items-center gap-2 md:gap-3 mb-10 reveal">
          {data.subtitle.map((s) => (
            <span class="hero-chip">
              <span>{s}</span>
            </span>
          ))}
        </div>

        <!-- Tagline -->
        <p class="text-base md:text-lg leading-relaxed max-w-3xl reveal mb-10" style="color:var(--color-ink-2)">
          {taglineLines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </p>

        <!-- CTA 按钮 -->
        <div class="flex flex-wrap items-center gap-4 reveal">
          <a href={data.cta.primary.href} class="btn-primary">
            {data.cta.primary.label}
          </a>
          <a href={data.cta.secondary.href} class="btn-ghost">
            {data.cta.secondary.label}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- 右侧：职业肖像照（图片加载失败 fallback 到 R 字母） -->
      <div class="hidden md:flex md:col-span-5 lg:col-span-4 justify-center items-center reveal">
        <div class="relative w-full max-w-[300px] aspect-[3/4]">
          <!-- 装饰：渐变光晕（Day 1.5: 60% → 20%，纸白底下更克制） -->
          <div
            class="absolute -inset-6 rounded-[2rem] blur-3xl opacity-20"
            style="background: linear-gradient(135deg, var(--color-accent-violet) 0%, var(--color-accent-soft) 100%);"
          ></div>
          <!-- 肖像照容器（Day 1.5: 边框改虚线，呼应整站虚线美学） -->
          <div
            class="relative w-full h-full rounded-2xl overflow-hidden"
            style="background: var(--color-canvas-tint); border: 1px dashed var(--color-border);"
          >
            <img
              src={data.portrait}
              alt={data.eyebrow}
              class="w-full h-full object-cover hero-portrait-img"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <!-- Fallback: 字母 R（图加载失败时显示） -->
            <div
              class="absolute inset-0 items-center justify-center font-serif font-semibold hidden"
              style="font-size: 8rem; color: var(--color-accent);"
            >
              R
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.875rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-ink-2);
    background: var(--color-canvas-tint);
    border: 1px solid transparent;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .hero-chip:hover {
    background: var(--color-highlight);
    color: var(--color-accent-deep);
    transform: translateY(-1px);
  }
</style>
